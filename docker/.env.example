# Template for docker/.env — copy this to docker/.env and fill in the blanks.
# docker/.env is gitignored; docker compose auto-loads it into the container.

# --- Weights & Biases --------------------------------------------------------
# Without WANDB_API_KEY, training falls back to file-logging.
WANDB_API_KEY=
WANDB_ENTITY=
# WANDB_PROJECT defaults to "giant"; override if you keep runs in a
# separate project.
# WANDB_PROJECT=giant

# --- Add more here as you need them ------------------------------------------
# HF_TOKEN=
