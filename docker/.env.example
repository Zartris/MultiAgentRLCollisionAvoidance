# Template for docker/.env — copy this to docker/.env and fill in the blanks.
# docker/.env is gitignored; docker compose auto-loads it into the container.

# --- Weights & Biases --------------------------------------------------------
# Required for train.agent.* tooling (status.py, nanny.py, cleanup.py, etc.).
# Without WANDB_API_KEY, train.agent.run falls back to file-logging.
WANDB_API_KEY=
WANDB_ENTITY=
# WANDB_PROJECT defaults to "malp" in the agent CLIs; override if you keep
# agent runs in a separate project.
# WANDB_PROJECT=malp

# --- Add more here as you need them ------------------------------------------
# HF_TOKEN=
# OPENAI_API_KEY=
